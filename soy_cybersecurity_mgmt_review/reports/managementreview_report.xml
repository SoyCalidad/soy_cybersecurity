<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="mgmtreview_document_template" inherit_id="mgmtsystem_management_review.report_mgmtreview_document">
        <t t-if="o.type_review=='iso9001'" position="after">
            <t t-if="o.type_review=='iso27k'">
                <div class="report-page">

                    <span class="report-section-title">
                        1. INTRODUCCIÓN
                    </span>

                    <span t-field="o.introduction" />
                    <br />
                    <span class="report-section-title">
                        RESPONSABLES DE REVISIÓN POR LA DIRECCIÓN
                    </span>
                    <t t-if="o.team_id">
                        <t t-foreach="o.team_id.member_ids" t-as="e">
                            <div class="reviewer-card d-inline-block align-top">
                                <span class="reviewer-name"
                                    t-field="e.employee_id.name" />
                                <br />
                                <t t-if="e.job_id">
                                    <span t-field="e.job_id" />
                                </t>
                            </div>
                        </t>
                    </t>
                </div>
                <!-- =====================================================
                     2. INFORMACIÓN DE ENTRADA
                     ===================================================== -->
                <div class="report-page report-page-break contents">
                    <span class="report-section-title">
                        2. INFORMACIÓN DE ENTRADA PARA LA REVISIÓN
                    </span>
                    <span class="report-section-title-light">
                        A. ESTADO DE LAS ACCIONES DE REVISIONES POR LA DIRECCIÓN PREVIAS										
                    </span>
                    <span class="report-section-title-light">
                        B. CAMBIOS EN LAS CUESTIONES EXTERNAS E INTERNAS
                    </span>
                     
                    <span class="report-section-title-light">
                        C. CAMBIOS EN LAS NECESIDADES Y EXPECTATIVAS DE LAS PARTES INTERESADAS										

                    </span>
                    
                    <span class="report-section-title-light">
                        D. INFORMACIÓN SOBRE EL DESEMPEÑO Y LA EFICACIA DEL SGSI
                    </span>
                    <span class="report-subsection-title d1">D.1 No conformidades y acciones correctivas</span>
                    <span class="report-subsection-title d2">D.2 Resultados de seguimiento y medición
</span>
                    <span class="report-subsection-title d3">D.3 Resultados de auditorías</span>
                    <span class="report-subsection-title d4">D.4 Objetivos de seguridad de la información</span> 

                    <span class="report-section-title-light">
                        E. RETROALIMENTACIÓN DE LAS PARTES INTERESADAS
                    </span>
                    <span class="report-section-title-light">
                        F. RESULTADOS DE LA EVALUACIÓN DE RIESGOS Y ESTADO DEL PLAN DE TRATAMIENTO
                    </span>
                    <span class="report-section-title-light">
                        G. OPORTUNIDADES DE MEJORA CONTINUA
                    </span>

                </div>


                <!-- =====================================================
                     A. ACCIONES DE REVISIONES PREVIAS
                     ===================================================== -->
                <div class="report-page">
                    <span class="report-section-title">
                        A. El estado de las acciones de las revisiones por la dirección previas
                    </span>
                    <t t-raw="o.record_meeting_actions" />
                </div>


                <!-- =====================================================
                     B. CAMBIOS EN CUESTIONES EXTERNAS E INTERNAS
                     ===================================================== -->
                <div class="report-page">
                    <span class="report-section-title">
                        B. Cambios en las cuestiones externas e internas
                    </span>
                    <t t-raw="o.foda" />
                    <span t-field="o.foda_description" />
                    <br />
                   
                </div>

                <div id="section_c" class="report-page">
                    <span class="report-section-title">
                        C. CAMBIOS EN LAS NECESIDADES Y EXPECTATIVAS DE LAS PARTES INTERESADAS	
                    </span> 

                    <h5>Interesados internos</h5>

                    <table t-if="o.stakeholders_id"
                        class="table table-bordered">

                        <thead>
                            <tr>
                                <th>Parte interesada</th>
                                <th>Interesado</th>
                                <th>Calificación</th>
                            </tr>
                        </thead>

                        <tbody>
                            <t t-foreach="o.stakeholders_id.stakeholder_in_ids"
                                t-as="record">

                                <tr>
                                    <td>
                                        <span t-field="record.name" />
                                    </td>

                                    <td>
                                        <span t-field="record.partner_id" />
                                    </td>

                                    <td>
                                        <span t-field="record.calification" />
                                    </td>
                                </tr>

                            </t>
                        </tbody>

                    </table>

                    <h5>Interesados externos</h5>
                    <table t-if="o.stakeholders_id"
                        class="table table-bordered">

                        <thead>
                            <tr>
                                <th>Parte interesada</th>
                                <th>Interesado</th>
                                <th>Calificación</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.stakeholders_id.stakeholder_out_ids"
                                t-as="record">
                                <tr>
                                    <td>
                                        <span t-field="record.name" />
                                    </td>

                                    <td>
                                        <span t-field="record.partner_id" />
                                    </td>

                                    <td>
                                        <span t-field="record.calification" />
                                    </td>
                                </tr>

                            </t>
                        </tbody>

                    </table>
                    <br />
                    <span t-field="o.stakeholders_description" />
                    <br />


                </div>


                <div id="section_d" class="report-page">
                    <span class="report-section-title">
                        D. INFORMACIÓN SOBRE EL DESEMPEÑO Y LA EFICACIA DEL SGSI
                    </span>

                    <span class="report-section-title">
                        D.1 No conformidades y acciones correctivas
                    </span>

                    <t t-raw="o.nonconformity_action" />

                    <div>
                        <span t-field="o.nonconformity_action_description" />

                    </div>

                    <span class="report-section-title">
                        D.2 Resultados de seguimiento y medición
                    </span>

                     <t t-raw="o.target" />

                    <span t-field="o.target_description" />


                    <span class="report-section-title">
                       D.3 Resultados de auditorías
                    </span>
                    <t t-raw="o.audit" />
                    <span t-field="o.audit_description" />

                    <span class="report-section-title">
                        D.4 Objetivos de seguridad de la información
                    </span>
                    <t t-raw="o.measurement_html" />
                    <span t-field="o.measurement_description" />


                    <span class="report-section-title">
                      D.6 Desempeño de riesgos y oportunidades
                    </span>
                    <t t-raw="o.risk" />
                    <t t-raw="o.risk_description" />
                </div>

                <div class="report-page" id="item_e">
                    <span class="report-section-title">
                        E. RETROALIMENTACIÓN DE LAS PARTES INTERESADAS
                    </span>

                    <t t-raw="o.communication_plan_html" />
                    <t t-raw="o.communication_plan_inter" />


                </div>
                <div class="report-page" id="item_f">
                    <span class="report-section-title">
                        F. RESULTADOS DE LA EVALUACIÓN DE RIESGOS Y ESTADO DEL PLAN DE TRATAMIENTO								
                    </span>

                    <t t-raw="o.sc27k_soa_matrix_html" />
                    <t t-raw="o.sc27k_soa_matrix_inter" />

                </div>
                <div class="report-page" id="item_g">
                    <span class="report-section-title">
                        G. OPORTUNIDADES DE MEJORA CONTINUA	
                    </span>

                    <t t-raw="o.improve_action" />
                    <span t-field="o.improve_action_des" />

                </div>
            </t>
        </t>
    </template>
</odoo>