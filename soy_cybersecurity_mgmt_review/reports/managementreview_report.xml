<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="mgmtreview_document_template" inherit_id="mgmtsystem_management_review.report_mgmtreview_document">
        <t t-if="o.type_review=='iso9001'" position="after">
            <t t-if="o.type_review=='iso27k'">
                <div class="report-page">

                    <span class="report-section-title">
                        1. INTRODUCTION
                    </span>

                    <span t-field="o.introduction" />
                    <br />
                    <span class="report-section-title">
                        MANAGEMENT REVIEW RESPONSIBLE PERSONS
                    </span>
                    <t t-if="o.team_id">
                        <t t-foreach="o.team_id.member_ids" t-as="e">
                            <div class="reviewer-card d-inline-block align-top">
                                <span class="reviewer-name"
                                    t-field="e.employee_id.name" />
                                <br />
                                <t t-if="e.job_id">
                                    <span t-field="e.job_id" />
                                </t>
                            </div>
                        </t>
                    </t>
                </div>
                <!-- =====================================================
                     2. INFORMACIÓN DE ENTRADA
                     ===================================================== -->
                <div class="report-page report-page-break contents">
                    <span class="report-section-title">
                        2. REVIEW INPUTS
                    </span>
                    <span class="report-section-title-light">
                        A. STATUS OF ACTIONS FROM PREVIOUS MANAGEMENT REVIEWS										
                    </span>
                    <span class="report-section-title-light">
                        B. CHANGES IN EXTERNAL AND INTERNAL ISSUES
                    </span>
                     
                    <span class="report-section-title-light">
                        C. CHANGES IN THE NEEDS AND EXPECTATIONS OF INTERESTED PARTIES										

                    </span>
                    
                    <span class="report-section-title-light">
                        D. INFORMATION ON THE PERFORMANCE AND EFFECTIVENESS OF THE ISMS
                    </span>
                    <span class="report-subsection-title d1">D.1 Nonconformities and corrective actions</span>
                    <span class="report-subsection-title d2">D.2 Monitoring and measurement results
</span>
                    <span class="report-subsection-title d3">D.3 Audit results</span>
                    <span class="report-subsection-title d4">D.4 Information security objectives</span> 

                    <span class="report-section-title-light">
                        E. FEEDBACK FROM INTERESTED PARTIES
                    </span>
                    <span class="report-section-title-light">
                        F. RISK ASSESSMENT RESULTS AND STATUS OF THE RISK TREATMENT PLAN
                    </span>
                    <span class="report-section-title-light">
                        G. OPPORTUNITIES FOR CONTINUAL IMPROVEMENT
                    </span>

                </div>


                <!-- =====================================================
                     A. ACCIONES DE REVISIONES PREVIAS
                     ===================================================== -->
                <div class="report-page">
                    <span class="report-section-title">
                        A. The status of the actions from previous management reviews
                    </span>
                    <t t-raw="o.record_meeting_actions" />
                </div>


                <!-- =====================================================
                     B. CAMBIOS EN CUESTIONES EXTERNAS E INTERNAS
                     ===================================================== -->
                <div class="report-page">
                    <span class="report-section-title">
                        B. Changes in external and internal issues
                    </span>
                    <t t-raw="o.foda" />
                    <span t-field="o.foda_description" />
                    <br />
                   
                </div>

                <div id="section_c" class="report-page">
                    <span class="report-section-title">
                        C. CHANGES IN THE NEEDS AND EXPECTATIONS OF INTERESTED PARTIES	
                    </span> 

                    <h5>Internal interested parties</h5>

                    <table t-if="o.stakeholders_id"
                        class="table table-bordered">

                        <thead>
                            <tr>
                                <th>Interested party</th>
                                <th>Stakeholder</th>
                                <th>Rating</th>
                            </tr>
                        </thead>

                        <tbody>
                            <t t-foreach="o.stakeholders_id.stakeholder_in_ids"
                                t-as="record">

                                <tr>
                                    <td>
                                        <span t-field="record.name" />
                                    </td>

                                    <td>
                                        <span t-field="record.partner_id" />
                                    </td>

                                    <td>
                                        <span t-field="record.calification" />
                                    </td>
                                </tr>

                            </t>
                        </tbody>

                    </table>

                    <h5>External interested parties</h5>
                    <table t-if="o.stakeholders_id"
                        class="table table-bordered">

                        <thead>
                            <tr>
                                <th>Interested party</th>
                                <th>Stakeholder</th>
                                <th>Rating</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.stakeholders_id.stakeholder_out_ids"
                                t-as="record">
                                <tr>
                                    <td>
                                        <span t-field="record.name" />
                                    </td>

                                    <td>
                                        <span t-field="record.partner_id" />
                                    </td>

                                    <td>
                                        <span t-field="record.calification" />
                                    </td>
                                </tr>

                            </t>
                        </tbody>

                    </table>
                    <br />
                    <span t-field="o.stakeholders_description" />
                    <br />


                </div>


                <div id="section_d" class="report-page">
                    <span class="report-section-title">
                        D. INFORMATION ON THE PERFORMANCE AND EFFECTIVENESS OF THE ISMS
                    </span>

                    <span class="report-section-title">
                        D.1 Nonconformities and corrective actions
                    </span>

                    <t t-raw="o.nonconformity_action" />

                    <div>
                        <span t-field="o.nonconformity_action_description" />

                    </div>

                    <span class="report-section-title">
                        D.2 Monitoring and measurement results
                    </span>

                     <t t-raw="o.target" />

                    <span t-field="o.target_description" />


                    <span class="report-section-title">
                       D.3 Audit results
                    </span>
                    <t t-raw="o.audit" />
                    <span t-field="o.audit_description" />

                    <span class="report-section-title">
                        D.4 Information security objectives
                    </span>
                    <t t-raw="o.measurement_html" />
                    <span t-field="o.measurement_description" />


                    <span class="report-section-title">
                      D.6 Risk and opportunity performance
                    </span>
                    <t t-raw="o.risk" />
                    <t t-raw="o.risk_description" />
                </div>

                <div class="report-page" id="item_e">
                    <span class="report-section-title">
                        E. FEEDBACK FROM INTERESTED PARTIES
                    </span>

                    <t t-raw="o.communication_plan_html" />
                    <t t-raw="o.communication_plan_inter" />


                </div>
                <div class="report-page" id="item_f">
                    <span class="report-section-title">
                        F. RISK ASSESSMENT RESULTS AND STATUS OF THE RISK TREATMENT PLAN								
                    </span>

                    <t t-raw="o.sc27k_soa_matrix_html" />
                    <t t-raw="o.sc27k_soa_matrix_inter" />

                </div>
                <div class="report-page" id="item_g">
                    <span class="report-section-title">
                        G. OPPORTUNITIES FOR CONTINUAL IMPROVEMENT	
                    </span>

                    <t t-raw="o.improve_action" />
                    <span t-field="o.improve_action_des" />

                </div>
            </t>
        </t>
    </template>
</odoo>