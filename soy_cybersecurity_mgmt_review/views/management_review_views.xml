<odoo>
    <data>
        <!-- Hereda la vista original -->
        <record id="management_review_form_view_inherit" model="ir.ui.view">
            <field name="name">management.review.form.view.inherit</field>
            <field name="model">management.review</field>
            <field name="inherit_id" ref="mgmtsystem_management_review.management_review_form_view" />
            <field name="arch" type="xml">
                <!-- Reemplaza el contenido de la página "detail" -->
                <page name="detail" position="inside">
                    <div class="main_27k" invisible="not (type_review == 'iso27k')">

                        <group colspan="2" name="detail_a">
                            <div class="w-100">
                                <div class="mt-0 mb-auto ">
                                    <h3>
                                        A. ESTADO DE LAS ACCIONES DE REVISIONES POR LA DIRECCIÓN
                                        PREVIAS
                                    </h3>
                                </div>
                                <p>
                                    Se revisa el estado de las acciones acordadas en revisiones
                                    previas del SGSI.
                                </p>
                            </div>
                            <group colspan="2">
                                <field name="record_meeting_ids" widget="many2many_tags"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']" />
                                <field name="record_meeting_actions" />
                                <field name="conclusion_a_section" string="Interpretación" />
                            </group>
                        </group>
                        <div class="mt-3"></div>
                        <group colspan="2" name="detail_b">
                            <div class="w-100">
                                <div class="mt-0 mb-auto">
                                    <h3>B. CAMBIOS EN LAS CUESTIONES EXTERNAS E INTERNAS</h3>
                                </div>
                                <p>
                                    Se revisan los cambios del contexto que puedan afectar al SGSI,
                                    incluyendo cambios tecnológicos, regulatorios, organizacionales
                                    y la consideración del cambio climático cuando resulte
                                    pertinente.
                                </p>
                            </div>
                            <group col="2" colspan="2">
                                <field name="foda"
                                    string="FODA / análisis de contexto"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']" />
                                <field name="foda_description"
                                    string="Interpretación"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']" />
                            </group>

                        </group>
                        <group id="item_c">
                            <div class="w-100">
                                <div class="mb-auto">
                                    <h3>C. CAMBIOS EN LAS NECESIDADES Y EXPECTATIVAS DE LAS PARTES
                                        INTERESADAS</h3>
                                </div>
                                <p class="">
                                    Se revisan cambios en requisitos pertinentes de clientes,
                                    autoridades, personal, proveedores y demás partes interesadas.
                                </p>
                            </div>

                            <group colspan="2" col="2">
                                <field name="stakeholders_id"
                                    string="Partes interesadas y requisitos"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']" />
                                <field name="stakeholders_description"
                                    string="Interpretación"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']" />
                            </group>


                        </group>
                        <div class="spacer"></div>
                        <group id="item_d">
                            <div class="w-100">
                                <div class="">
                                    <h3>D. INFORMACIÓN SOBRE EL DESEMPEÑO Y LA EFICACIA DEL SGSI</h3>
                                </div>
                                <div class="">
                                    <h3>Se revisan tendencias de no conformidades, seguimiento y
                                        medición, auditorías y cumplimiento de objetivos de
                                        seguridad de la información.
                                    </h3>
                                </div>
                            </div>
                            <group colspan="2">
                                <field name="nonconformity_action"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']"
                                    string="D.1 No conformidades y acciones correctivas" />
                                <field name="nonconformity_action_description"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']"
                                    string="Interpretación" />
                            </group>
                            <group colspan="2">
                                <field name="target"
                                    string="D.2 Resultados de seguimiento y medición"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']"
                                />
                                <field name="target_description" string="Interpretación"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']"
                                />

                            </group>


                            <group colspan="2">
                                <field name="audit"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']"
                                    string="D.3 Resultados de auditorías" />
                                <field name="audit_description"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']"
                                    string="Interpretación"
                                />
                            </group>

                            <group colspan="2">
                                <field name="measurement_html"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']"
                                    string="D.4 Objetivos de seguridad de la información" />
                                <field name="measurement_description"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']"
                                    string="Interpretación" />
                            </group>


                        </group>
                        <group id="item_e">
                            <div class="w-100">
                                <div class="">
                                    <h3>E. RETROALIMENTACIÓN DE LAS PARTES INTERESADAS</h3>
                                </div>
                                <div>
                                    <p>
                                        Se evalúa la suficiencia de recursos para mantener el SGA y
                                        mejorar el desempeño ambiental.
                                    </p>
                                </div>
                            </div>
                            <group colspan="2">
                                <field name="communication_plan_html"
                                    string="Retroalimentación / comunicaciones"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']" />
                                <field name="communication_plan_inter"
                                    string="Interpretación"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']" />
                            </group>
                        </group>
                        <group id="item_f">
                            <div class="w-100">
                                <div class="">
                                    <h3>F. RESULTADOS DE LA EVALUACIÓN DE RIESGOS Y ESTADO DEL PLAN
                                        DE TRATAMIENTO</h3>
                                </div>
                                <div>
                                    <p>
                                        Se revisa la evolución de los riesgos, los riesgos
                                        residuales y el estado de implementación del plan de
                                        tratamiento.
                                    </p>
                                </div>
                            </div>
                            <group colspan="2">
                                <field name="sc27k_soa_matrix_html"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']" />
                                <field name="sc27k_soa_matrix_inter"
                                    string="Interpretación"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']" />
                            </group>
                        </group>

                        <group id="item_g">
                            <div class="w-100">
                                <div class="">
                                    <h3>G. OPORTUNIDADES DE MEJORA CONTINUA</h3>
                                </div>
                                <div>
                                    <p>
                                        Se identifican oportunidades para fortalecer la eficacia del
                                        SGSI.
                                    </p>
                                </div>
                            </div>
                            <group colspan="2">
                                <field name="improve_action"
                                    string="Oportunidades identificadas"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']" />
                                <field name="improve_action_des"
                                    string="Interpretación"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']" />
                            </group>
                        </group>

                    </div>

                </page>

            </field>
        </record>

        <record model="ir.actions.act_window" id="action_management_review_27k">
            <field name="name">Revisión por la dirección</field>
            <field name="res_model">management.review</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('state', '!=', 'cancel'),('type_review','=', 'iso27k')]</field>
            <field name="context">{'form_view_ref':'mgmtsystem_management_review.management_review_form_view',
                'default_type_review': 'iso27k', 'invisible_type_review': False, 'readonly_type_review': True}</field>
            <field name="help" type="html">
                <h4>
                    Cree revisiones por la dirección para la ISO 27001
                </h4>
            </field>
        </record>
    </data>
</odoo>                    