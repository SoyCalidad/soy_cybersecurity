<odoo>
    <data>
        <!-- Hereda la vista original -->
        <record id="management_review_form_view_inherit" model="ir.ui.view">
            <field name="name">management.review.form.view.inherit</field>
            <field name="model">management.review</field>
            <field name="inherit_id" ref="mgmtsystem_management_review.management_review_form_view" />
            <field name="arch" type="xml">
                <!-- Reemplaza el contenido de la página "detail" -->
                <page name="detail" position="inside">
                    <div class="main_27k" invisible="not (type_review == 'iso27k')">

                        <group colspan="2" name="detail_a">
                            <div class="w-100">
                                <div class="mt-0 mb-auto ">
                                    <h3>
                                        A. STATUS OF ACTIONS FROM PREVIOUS MANAGEMENT REVIEWS
                                    </h3>
                                </div>
                                <p>
                                    The status of the actions agreed in previous ISMS reviews is reviewed.
                                </p>
                            </div>
                            <group colspan="2">
                                <field name="record_meeting_ids" widget="many2many_tags"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']" />
                                <field name="record_meeting_actions" />
                                <field name="conclusion_a_section" string="Interpretation" />
                            </group>
                        </group>
                        <div class="mt-3"></div>
                        <group colspan="2" name="detail_b">
                            <div class="w-100">
                                <div class="mt-0 mb-auto">
                                    <h3>B. CHANGES IN EXTERNAL AND INTERNAL ISSUES</h3>
                                </div>
                                <p>
                                    Changes in the context that may affect the ISMS are reviewed, including technological, regulatory and organizational changes and the consideration of climate change where relevant.
                                </p>
                            </div>
                            <group col="2" colspan="2">
                                <field name="foda"
                                    string="SWOT / context analysis"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']" />
                                <field name="foda_description"
                                    string="Interpretation"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']" />
                            </group>

                        </group>
                        <group id="item_c">
                            <div class="w-100">
                                <div class="mb-auto">
                                    <h3>C. CHANGES IN THE NEEDS AND EXPECTATIONS OF INTERESTED PARTIES</h3>
                                </div>
                                <p class="">
                                    Changes in the relevant requirements of customers, authorities, staff, suppliers and other interested parties are reviewed.
                                </p>
                            </div>

                            <group colspan="2" col="2">
                                <field name="stakeholders_id"
                                    string="Interested parties and requirements"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']" />
                                <field name="stakeholders_description"
                                    string="Interpretation"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']" />
                            </group>


                        </group>
                        <div class="spacer"></div>
                        <group id="item_d">
                            <div class="w-100">
                                <div class="">
                                    <h3>D. INFORMATION ON THE PERFORMANCE AND EFFECTIVENESS OF THE ISMS</h3>
                                </div>
                                <div class="">
                                    <h3>Trends in nonconformities, monitoring and measurement, audits and the fulfilment of information security objectives are reviewed.
                                    </h3>
                                </div>
                            </div>
                            <group colspan="2">
                                <field name="nonconformity_action"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']"
                                    string="D.1 Nonconformities and corrective actions" />
                                <field name="nonconformity_action_description"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']"
                                    string="Interpretation" />
                            </group>
                            <group colspan="2">
                                <field name="target"
                                    string="D.2 Monitoring and measurement results"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']"
                                />
                                <field name="target_description" string="Interpretation"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']"
                                />

                            </group>


                            <group colspan="2">
                                <field name="audit"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']"
                                    string="D.3 Audit results" />
                                <field name="audit_description"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']"
                                    string="Interpretation"
                                />
                            </group>

                            <group colspan="2">
                                <field name="measurement_html"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']"
                                    string="D.4 Information security objectives" />
                                <field name="measurement_description"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']"
                                    string="Interpretation" />
                            </group>


                        </group>
                        <group id="item_e">
                            <div class="w-100">
                                <div class="">
                                    <h3>E. FEEDBACK FROM INTERESTED PARTIES</h3>
                                </div>
                                <div>
                                    <p>
                                        The adequacy of resources to maintain the EMS and improve environmental performance is evaluated.
                                    </p>
                                </div>
                            </div>
                            <group colspan="2">
                                <field name="communication_plan_html"
                                    string="Feedback / communications"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']" />
                                <field name="communication_plan_inter"
                                    string="Interpretation"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']" />
                            </group>
                        </group>
                        <group id="item_f">
                            <div class="w-100">
                                <div class="">
                                    <h3>F. RISK ASSESSMENT RESULTS AND STATUS OF THE RISK TREATMENT PLAN</h3>
                                </div>
                                <div>
                                    <p>
                                        The evolution of risks, residual risks and the implementation status of the treatment plan are reviewed.
                                    </p>
                                </div>
                            </div>
                            <group colspan="2">
                                <field name="sc27k_soa_matrix_html"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']" />
                                <field name="sc27k_soa_matrix_inter"
                                    string="Interpretation"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']" />
                            </group>
                        </group>

                        <group id="item_g">
                            <div class="w-100">
                                <div class="">
                                    <h3>G. OPPORTUNITIES FOR CONTINUAL IMPROVEMENT</h3>
                                </div>
                                <div>
                                    <p>
                                        Opportunities to strengthen the effectiveness of the ISMS are identified.
                                    </p>
                                </div>
                            </div>
                            <group colspan="2">
                                <field name="improve_action"
                                    string="Identified opportunities"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']" />
                                <field name="improve_action_des"
                                    string="Interpretation"
                                    readonly="not can_edit_form and state in ['validate_ok', 'closed', 'cancel']" />
                            </group>
                        </group>

                    </div>

                </page>

            </field>
        </record>

        <record model="ir.actions.act_window" id="action_management_review_27k">
            <field name="name">Management review</field>
            <field name="res_model">management.review</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('state', '!=', 'cancel'),('type_review','=', 'iso27k')]</field>
            <field name="context">{'form_view_ref':'mgmtsystem_management_review.management_review_form_view',
                'default_type_review': 'iso27k', 'invisible_type_review': False, 'readonly_type_review': True}</field>
            <field name="help" type="html">
                <h4>
                    Create management reviews for ISO 27001
                </h4>
            </field>
        </record>
    </data>
</odoo>                    