<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cyber_matrix_block_line_form_view_sc27k_asset_inventory" model="ir.ui.view">
        <field name="name">cyber.matrix.block.line.form.view.sc27k.asset.inventory</field>
        <field name="model">cyber_matrix.block.line</field>
        <field name="inherit_id" ref="soy_cybersecurity_cybersecurity.cyber_view_matrix_block_line_form" />
        <field name="arch" type="xml">
            <!-- Fields not part of the ISO 27001 security profile maqueta. -->
            <field name="department_id" position="attributes">
                <attribute name="invisible">sc27k_is_security_profile</attribute>
            </field>
            <field name="resource_id" position="attributes">
                <attribute name="invisible">sc27k_is_security_profile</attribute>
            </field>
            <field name="asset_susceptible_to_fraud" position="attributes">
                <attribute name="invisible">sc27k_is_security_profile</attribute>
            </field>
            <field name="asset_vital_for_organization" position="attributes">
                <attribute name="invisible">sc27k_is_security_profile</attribute>
            </field>
            <field name="language_id" position="attributes">
                <attribute name="invisible">sc27k_is_security_profile</attribute>
            </field>
            <field name="storage_medium" position="attributes">
                <attribute name="invisible">sc27k_is_security_profile</attribute>
            </field>

            <!-- The generic free-form "Tipo" is replaced by the fixed MAGERIT list
                 (sc27k_asset_type) for the security profile. -->
            <field name="asset_type_id" position="attributes">
                <attribute name="invisible">sc27k_is_security_profile</attribute>
            </field>

            <field name="description" position="after">
                <field name="sc27k_owner_job_id"
                    readonly="state not in ['draft','in_process']" />
            </field>
            <field name="location_id" position="after">
                <field name="sc27k_information_classification"
                    readonly="state not in ['draft','in_process']" />
                <field name="sc27k_asset_code"
                    required="1"
                    readonly="state not in ['draft','in_process']" />
                <field name="sc27k_next_review_date"
                    readonly="state not in ['draft','in_process']" />
                <field name="sc27k_category_ids" widget="many2many_tags" />
            </field>
            
            <field name="code" position="after">
                <field name="sc27k_asset_type"
                    invisible="not sc27k_is_security_profile"
                    readonly="state not in ['draft','in_process']" />
                <field name="sc27k_security_certification" readonly="state not in ['draft','in_process']" />
            </field>
            <field name="process_id" position="after">
                <field name="sc27k_custodian_id"
                    readonly="state not in ['draft','in_process']" />
                <field name="sc27k_ownership"
                    readonly="state not in ['draft','in_process']" />
                <field name="sc27k_personal_data_level"
                    readonly="state not in ['draft','in_process']" />
                <field name="sc27k_last_review_date"
                    readonly="state not in ['draft','in_process']" />
            </field>
            <field name="asset_type_id" position="after">
                
                <field name="sc27k_asset_state"
                    readonly="state not in ['draft','in_process']" />
                
                <field name="sc27k_criticality" />
            </field>
        </field>
    </record>

    <record id="cyber_matrix_block_line_list_view_sc27k_asset_inventory" model="ir.ui.view">
        <field name="name">cyber.matrix.block.line.list.view.sc27k.asset.inventory</field>
        <field name="model">cyber_matrix.block.line</field>
        <field name="inherit_id" ref="soy_cybersecurity_cybersecurity.cyber_view_matrix_block_line_list" />
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="sc27k_asset_code" />
            </field>
            <field name="user_id" position="after">
                <field name="sc27k_criticality" />
                <field name="sc27k_asset_state" />
            </field>
        </field>
    </record>

</odoo>
