<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cyber_policy_view_form" model="ir.ui.view">
        <field name="name">mgmtsystem.context.policy.view.form</field>
        <field name="model">mgmtsystem.context.policy</field>
        <field name="inherit_id" ref="mgmtsystem_context.context_policy_view_form"/>
        <field name="arch" type="xml">
            <page name="document" position="inside">
                <group 
                invisible="system_id != %(sc27k_base.system_cybersecurity)d"
                
                >
                    <field name="cyber_organization_context" string="Context of the organization" 
                    readonly="state in ['validate_ok', 'cancel']"
                    />
                    <field name="cyber_direction_help" string="Management support" 
                    readonly="state in ['validate_ok', 'cancel']"
                    
                    />
                                
                    <field name="cyber_risk_handling" string="Risk assessment and treatment" 
                    readonly="state in ['validate_ok', 'cancel']"
                    />  
                    <field name="cyber_legal_req" string="Legal Requirements" 
                    readonly="state in ['validate_ok', 'cancel']"  
                    />
                    <field name="cyber_responsibility_assignment" string="Assignment of responsibilities" 
                    readonly="state in ['validate_ok', 'cancel']"
                    />

                    <field name="cyber_standard_commitment" string="Commitment to the requirements of the standard" 
                    readonly="state in ['validate_ok', 'cancel']" 
                    
                    />  
                    <field name="cyber_staff_participation" string="Staff participation" 
                    readonly="state in ['validate_ok', 'cancel']"
                    />
                    <field name="cyber_continuous_improvement" string="Continual improvement" 
                    readonly="state in ['validate_ok', 'cancel']" 
                     />  
                    <field name="cyber_control_implementation" string="Implementation of controls" 
                    readonly="state in ['validate_ok', 'cancel']" 
                     />  
                    <field name="cyber_security_goals" string="Information security objectives" 
                    readonly="state in ['validate_ok', 'cancel']"  />

                </group>
            </page>
        </field>
    </record>
</odoo>