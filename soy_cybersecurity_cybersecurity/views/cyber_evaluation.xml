<odoo>
    <record id="cyber_evaluation_view_form" model="ir.ui.view">
        <field name="name">cyber_evaluation.evaluation.view.form</field>
        <field name="model">cyber_evaluation.evaluation</field>
        <field name="arch" type="xml">
            <form string="Evaluación">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active == True" />
                    <group>
                        <field name="name" />
                        <field name="active" invisible="1" />
                    </group>
                    <notebook>
                        <page string="Criterios">
                            <field name="criterio_ids">
                                <list>
                                    <field name="name" />
                                    <!-- Add other field definitions if needed -->
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cyber_evaluation_view_list" model="ir.ui.view">
        <field name="name">cyber_evaluation.evaluation.view.list</field>
        <field name="model">cyber_evaluation.evaluation</field>
        <field name="arch" type="xml">
            <list string="Evaluación">
                <field name="name" />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="cyber_evaluation_action">
        <field name="name">Evaluación</field>
        <field name="res_model">cyber_evaluation.evaluation</field>
        <field name="view_mode">list,form</field>
    </record>
 

</odoo>