<odoo>
    <data>

        <record id="cybersecurity_clause_list" model="ir.ui.view">
            <field name="name">cybersecurity.clause.list</field>
            <field name="model">cybersecurity.clause</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" />
                    <field name="question" />
                </list>
            </field>
        </record>


        <record id="cybersecurity_diagnostic_list" model="ir.ui.view">
            <field name="name">cybersecurity.diagnostic.list</field>
            <field name="model">cybersecurity.diagnostic</field>
            <field name="arch" type="xml">
                <list>
                    <field name="date_diagnostic" />
                    <field name="name" />
                    <field name="state" />
                    <field name="user_id" />
                </list>
            </field>
        </record>

        <record id="cybersecurity_diagnostic_line_form" model="ir.ui.view">
            <field name="name">cybersecurity.diagnostic.line.form</field>
            <field name="model">cybersecurity.diagnostic.line</field>
            <field name="arch" type="xml">
                <form string="Detalle de linea">
                    <group>
                        <field name="requirement_id" />
                        <field name="qualification" />
                        <field name="observation" />
                        <control>
                            <create name="add_section_control" string="Add a section" context="{'default_is_page': True}" />
                            <create name="add_question_control" string="Add a question" />
                        </control>
                        <field name="info" />
                    </group>
                </form>
            </field>
        </record>

        <record id="cybersecurity_diagnostic_form" model="ir.ui.view">
            <field name="name">cybersecurity.diagnostic.form</field>
            <field name="model">cybersecurity.diagnostic</field>
            <field name="arch" type="xml">
                <form string="Diagnostico">
                    <header>
                        <button name="evaluate_diagnostic"
                                invisible="state in ('draft')"
                                string="Generar Reporte"
                                type="object"
                                class="btn-primary"
                                groups="soy_cybersecurity_cybersecurity.group_cybersecurity_onlyread_printreport,soy_cybersecurity_cybersecurity.group_cybersecurity_user_secundario,soy_cybersecurity_cybersecurity.group_cybersecurity_write_printreport" />
                        <button name="change_state_draft"
                                invisible="state in ('draft','validate')"
                                string="Atrás"
                                type="object"
                                class="btn-primary"
                                groups="soy_cybersecurity_cybersecurity.group_cybersecurity_user_secundario,soy_cybersecurity_cybersecurity.group_cybersecurity_write_printreport" />
                        <button name="change_state_eval"
                                invisible="state in ('validate','evaluate')"
                                string="Analizar detalladamente"
                                type="object"
                                class="btn-primary oe_edit_only"
                                groups="soy_cybersecurity_cybersecurity.group_cybersecurity_user_secundario,soy_cybersecurity_cybersecurity.group_cybersecurity_write_printreport" />
                        <button name="change_state_validate"
                                invisible="state in ('draft','validate')"
                                string="Culminar"
                                type="object"
                                class="btn-primary"
                                groups="soy_cybersecurity_cybersecurity.group_cybersecurity_user_secundario,soy_cybersecurity_cybersecurity.group_cybersecurity_write_printreport" />
                        <field name="state" widget="statusbar" />
                    </header>
                    <sheet>
                        <group string="Detalles" invisible="state in ('evaluate')">
                            <group>
                                <field name="name" invisible="state in ('validate')" />
                                <field name="user_id" invisible="state in ('validate')" />
                                <field name="company_id" invisible="state in ('validate')" />
                                <field name="xls_helper" invisible="1" />
                            </group>
                            <group>
                                <field name="date_diagnostic" readonly="1"  />
                                <field name="date_validate" groups="base.group_no_one,base.group_system" readonly="1" />
                            </group>
                        </group>
                        <separator string="Análisis previo" invisible="state in ('evaluate','validate','evaluate')"/>
                        <field name="all_clause" invisible="state in ('evaluate','validate','evaluate')">
                            <list editable="bottom" delete="false">
                                <field name="name" />
                                <field name="question" readonly="1" />
                            </list>
                        </field>
                        <separator string="Evaluación" invisible="state in ('draft','validate')" />
                        <notebook invisible="state in ('draft','validate')">
                            <page string="4. Contexto">
                                <h1>4. Contexto de la organización</h1>
                                <h2>4.1 Comprensión de la organización y de su contexto</h2>
                                <h4>La organización debe</h4>
                                <field name="diagnostic4_1_ids">
                                    <list editable="bottom" delete="false">
                                        <field name="requirement_id" />
                                        <field name="name" style="max-width:400px;" />
                                        <field name="qualification" widget="priority" style="width:120px" />
                                        <field name="is_page" invisible="1" />
                                        <field name="observation" />
                                    </list>
                                </field>
                                <h2>4.2 Comprensión de las necesidades y expectativas de las partes interesadas</h2>
                                <h4>La organización debe</h4>
                                <field name="diagnostic4_2_ids">
                                    <list editable="bottom" delete="false">
                                        <field name="requirement_id" />
                                        <field name="name" style="max-width:400px;" />
                                        <field name="qualification" widget="priority" style="width:120px" />
                                        <field name="is_page" invisible="1" />
                                        <field name="observation" />
                                    </list>
                                </field>

                                <h2>4.3 Determinación del alcance del SGSI</h2>
                                <h4>La organización debe</h4>
                                <field name="diagnostic4_3_ids">
                                    <list editable="bottom" delete="false">
                                        <field name="requirement_id" />
                                        <field name="name" style="max-width:400px;" />
                                        <field name="qualification" widget="priority" style="width:120px" />
                                        <field name="is_page" invisible="1" />
                                        <field name="observation" />
                                    </list>
                                </field>
                                <h2>4.4 Sistema de gestión de seguridad de la informacións</h2>
                                <h4> La organización debe</h4>
                                <field name="diagnostic4_4_ids">
                                    <list editable="bottom" delete="false">
                                        <field name="requirement_id" />
                                        <field name="name" style="max-width:400px;" />
                                        <field name="qualification" widget="priority" style="width:120px" />
                                        <field name="is_page" invisible="1" />
                                        <field name="observation" />
                                    </list>
                                </field>
                                <group>
                                    <field name="diagnostic4_ids_100" widget="progressbar" options="{'current_value': 'diagnostic4_ids_100', 'max_value': 'diagnostic4_ids_total', 'editable': false}" />
                                    <field name="diagnostic4_ids_75" widget="progressbar" options="{'current_value': 'diagnostic4_ids_75', 'max_value': 'diagnostic4_ids_total', 'editable': false}" />
                                    <field name="diagnostic4_ids_50" widget="progressbar" options="{'current_value': 'diagnostic4_ids_50', 'max_value': 'diagnostic4_ids_total', 'editable': false}" />
                                    <field name="diagnostic4_ids_25" widget="progressbar" options="{'current_value': 'diagnostic4_ids_25', 'max_value': 'diagnostic4_ids_total', 'editable': false}" />
                                    <field name="diagnostic4_ids_0" widget="progressbar" options="{'current_value': 'diagnostic4_ids_0', 'max_value': 'diagnostic4_ids_total', 'editable': false}" />
                                </group>
                            </page>
                            <page string="5. Liderazgo">
                                <h1>5. Liderazgo</h1>
                                <h2>5.1 Liderazgo y compromiso</h2>
                                <h4>La alta dirección debe:</h4>
