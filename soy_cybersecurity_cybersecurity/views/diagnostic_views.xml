                                        <field name="name" style="max-width:400px;" />
                                        <field name="qualification" widget="priority" style="width:120px" />
                                        <field name="is_page" invisible="1" />
                                        <field name="observation" />
                                    </list>
                                </field>
                                <h2>7.3 Toma de Conciencia y formación </h2>
                                <h4>La organización debe:</h4>
                                <field name="diagnostic7_3_ids">
                                    <list editable="bottom" delete="false">
                                        <field name="requirement_id" />
                                        <field name="name" style="max-width:400px;" />
                                        <field name="qualification" widget="priority" style="width:120px" />
                                        <field name="is_page" invisible="1" />
                                        <field name="observation" />
                                    </list>
                                </field>
                                <h2>7.4 Comunicación</h2>
                                <h4>La organización debe:</h4>
                                <field name="diagnostic7_4_ids">
                                    <list editable="bottom" delete="false">
                                        <field name="requirement_id" />
                                        <field name="name" style="max-width:400px;" />
                                        <field name="qualification" widget="priority" style="width:120px" />
                                        <field name="is_page" invisible="1" />
                                        <field name="observation" />
                                    </list>
                                </field>
                                <h2>7.5 Informacion Documentada</h2>
                                <h4>La organización debe:</h4>
                                <field name="diagnostic7_5_ids">
                                    <list editable="bottom" delete="false">
                                        <field name="requirement_id" />
                                        <field name="name" style="max-width:400px;" />
                                        <field name="qualification" widget="priority" style="width:120px" />
                                        <field name="is_page" invisible="1" />
                                        <field name="observation" />
                                    </list>
                                </field>
                                
                                <group>
                                    <field name="diagnostic7_ids_100" widget="progressbar" options="{'current_value': 'diagnostic7_ids_100', 'max_value': 'diagnostic7_ids_total', 'editable': false}" />
                                    <field name="diagnostic7_ids_75" widget="progressbar" options="{'current_value': 'diagnostic7_ids_75', 'max_value': 'diagnostic7_ids_total', 'editable': false}" />
                                    <field name="diagnostic7_ids_50" widget="progressbar" options="{'current_value': 'diagnostic7_ids_50', 'max_value': 'diagnostic7_ids_total', 'editable': false}" />
                                    <field name="diagnostic7_ids_25" widget="progressbar" options="{'current_value': 'diagnostic7_ids_25', 'max_value': 'diagnostic7_ids_total', 'editable': false}" />
                                    <field name="diagnostic7_ids_0" widget="progressbar" options="{'current_value': 'diagnostic7_ids_0', 'max_value': 'diagnostic7_ids_total', 'editable': false}" />
                                </group>
                            </page>
                            <page string="8. Operación">
