                                    <field name="diagnostic9_ids_75" widget="progressbar" options="{'current_value': 'diagnostic9_ids_75', 'max_value': 'diagnostic9_ids_total', 'editable': false}" />
                                    <field name="diagnostic9_ids_50" widget="progressbar" options="{'current_value': 'diagnostic9_ids_50', 'max_value': 'diagnostic9_ids_total', 'editable': false}" />
