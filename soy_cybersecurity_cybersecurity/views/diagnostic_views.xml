                                    <field name="diagnostic6_ids_75" widget="progressbar" options="{'current_value': 'diagnostic6_ids_75', 'max_value': 'diagnostic6_ids_total', 'editable': false}" />
                                    <field name="diagnostic6_ids_50" widget="progressbar" options="{'current_value': 'diagnostic6_ids_50', 'max_value': 'diagnostic6_ids_total', 'editable': false}" />
                                    <field name="diagnostic6_ids_25" widget="progressbar" options="{'current_value': 'diagnostic6_ids_25', 'max_value': 'diagnostic6_ids_total', 'editable': false}" />
                                    <field name="diagnostic6_ids_0" widget="progressbar" options="{'current_value': 'diagnostic6_ids_0', 'max_value': 'diagnostic6_ids_total', 'editable': false}" />
                                </group>
                            </page>
                            <page string="7. Apoyo">
                                <h1>7. Apoyo</h1>
                                <h2>7.1 Recursos</h2>
                                <h4>La organización debe:</h4>
                                <field name="diagnostic7_1_ids">
                                    <list editable="bottom" delete="false">
                                        <field name="requirement_id" />
                                        <field name="name" style="max-width:400px;" />
                                        <field name="qualification" widget="priority" style="width:120px" />
                                        <field name="is_page" invisible="1" />
                                        <field name="observation" />
                                    </list>
                                </field>
                                <h2>7.2 Competencia</h2>
                                <h4>La organización debe:</h4>
                                <field name="diagnostic7_2_ids">
                                    <list editable="bottom" delete="false">
