                                    <field name="diagnostic5_ids_75" widget="progressbar" options="{'current_value': 'diagnostic5_ids_75', 'max_value': 'diagnostic5_ids_total', 'editable': false}" />
                                    <field name="diagnostic5_ids_50" widget="progressbar" options="{'current_value': 'diagnostic5_ids_50', 'max_value': 'diagnostic5_ids_total', 'editable': false}" />
                                    <field name="diagnostic5_ids_25" widget="progressbar" options="{'current_value': 'diagnostic5_ids_25', 'max_value': 'diagnostic5_ids_total', 'editable': false}" />
                                    <field name="diagnostic5_ids_0" widget="progressbar" options="{'current_value': 'diagnostic5_ids_0', 'max_value': 'diagnostic5_ids_total', 'editable': false}" />
                                </group>
                            </page>
                            <page string="6. Planificación">
                                <h1>6. Planificación</h1>
                                <h2>6.1 Acciones para tratar riesgos y oportunidades</h2>
                                <h4>La organización debe:</h4>
