        <!--lineas de Integridad-->

        <record model="cyber_evaluation.criterio.line" id="criterio_line_2_1">
            <field name="name">Low</field>
            <field name="criterio_id" ref="criterio_2"/>
            <field name="description">Important information, but its accuracy can tolerate slight modifications without serious consequences.</field>
            <field name="value_less">1</field>
            <field name="value_high">3</field>
        </record>
        <record model="cyber_evaluation.criterio.line" id="criterio_line_2_2">
            <field name="name">Moderate</field>
            <field name="criterio_id" ref="criterio_2"/>
            <field name="description">Very important information where accuracy is necessary, but small alterations do not cause serious damage.</field>
            <field name="value_less">4</field>
            <field name="value_high">7</field>
        </record>
        <record model="cyber_evaluation.criterio.line" id="criterio_line_2_3">
            <field name="name">High</field>
            <field name="criterio_id" ref="criterio_2"/>
            <field name="description">Critical information that must be kept accurate and unaltered.</field>
            <field name="value_less">8</field>
            <field name="value_high">10</field>
        </record>

        <!--lineas de Disponibilidad-->
        <record model="cyber_evaluation.criterio.line" id="criterio_line_3_1">
            <field name="name">Low</field>
            <field name="criterio_id" ref="criterio_3"/>
            <field name="description">Accessibility is important, but occasional interruptions can be tolerated without serious consequences.</field>
            <field name="value_less">1</field>
            <field name="value_high">3</field>
        </record>        
        <record model="cyber_evaluation.criterio.line" id="criterio_line_3_2">
            <field name="name">Medium</field>
            <field name="criterio_id" ref="criterio_3"/>
            <field name="description">It must be accessible in most cases, but brief periods of inaccessibility can be tolerated.</field>
            <field name="value_less">4</field>
            <field name="value_high">7</field>
        </record>
        <record model="cyber_evaluation.criterio.line" id="criterio_line_3_3">
            <field name="name">High</field>
            <field name="criterio_id" ref="criterio_3"/>
            <field name="description">It must always be accessible; its unavailability can cause serious damage.</field>
            <field name="value_less">8</field>
            <field name="value_high">10</field>
        </record>

</odoo>
