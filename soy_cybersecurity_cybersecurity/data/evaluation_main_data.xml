        <!--Criterios: cyber_evaluation_1-->
        <record model="cyber_evaluation.criterio" id="criterio_1">
            <field name="name">Confidentiality</field>
            <field name="description">Confidentiality refers to protecting information so that only authorized persons can access it. This includes protection against unauthorized access, disclosure, copying or modification.</field>
            <field name="evaluation_id" ref="cyber_evaluation_1"/>
        </record>
        <record model="cyber_evaluation.criterio" id="criterio_2">
            <field name="name">Integrity</field>
            <field name="description">Integrity refers to protecting information so that it is not modified, destroyed or corrupted without authorization. This includes protection against unauthorized access, modification, destruction or corruption.</field>
            <field name="evaluation_id" ref="cyber_evaluation_1"/>
        </record>
        <record model="cyber_evaluation.criterio" id="criterio_3">
            <field name="name">Availability</field>
            <field name="description">Availability refers to protecting information so that it is available when needed. This includes protection against loss, damage or interruption of access.</field>
            <field name="evaluation_id" ref="cyber_evaluation_1"/>
        </record>
        <!--Criterio: cyber_evaluation_2-->
        <!--
        <record model="cyber_evaluation.criterio" id="criterio_2_1">
            <field name="name">Impacto (I)</field>
            <field name="description">Para cada oportunidad se tiene en cuenta y se puntúa el mejor efecto que tenga en el cliente la oportunidad especificada.</field>
            <field name="evaluation_id" ref="cyber_evaluation_2"/>
        </record>
        -->

        <!--lineas de Confidencialidad-->
        <record model="cyber_evaluation.criterio.line" id="criterio_line_1_1">
            <field name="name">Unclassified</field>
            <field name="criterio_id" ref="criterio_1"/>
            <field name="description">Information without special restrictions, but not necessarily intended for the general public.</field>
            <field name="value_less">8</field>
            <field name="value_high">10</field>
        </record>
        <record model="cyber_evaluation.criterio.line" id="criterio_line_1_2">
            <field name="name">Public</field>
            <field name="criterio_id" ref="criterio_1"/>
            <field name="description">Information accessible to everyone without restrictions.</field>
            <field name="value_less">1</field>
            <field name="value_high">3</field>
        </record>
        <record model="cyber_evaluation.criterio.line" id="criterio_line_1_3">
            <field name="name">Confidential</field>
            <field name="criterio_id" ref="criterio_1"/>
            <field name="description">Sensitive information that could cause moderate damage if disclosed.</field>
            <field name="value_less">4</field>
            <field name="value_high">7</field>
        </record>
        <record model="cyber_evaluation.criterio.line" id="criterio_line_1_4">
            <field name="name">Highly confidential</field>
            <field name="criterio_id" ref="criterio_1"/>
            <field name="description">Critical information whose disclosure could cause serious damage.</field>
            <field name="value_less">8</field>
            <field name="value_high">10</field>
        </record>

