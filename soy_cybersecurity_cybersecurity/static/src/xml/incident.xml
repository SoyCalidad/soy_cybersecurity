<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="soy_cybersecurity_cybersecurity.incident" name="Incident">
        <t t-call="website.layout">
            <t t-set="head">
                <meta name="robots" content="noindex, nofollow"/>
            </t>
            <div class="center">
                <form action="/incidente_enviado" method="post" id="incidentForm" enctype="multipart/form-data">
                    <!-- progressbar -->
                    <ul id="progressbar">
                        <li class="active">Incident information</li>
                        <li>Additional information</li>
                        <li>Personal information</li>
                    </ul>
                    <!-- fieldsets -->
                    <fieldset>
                        <h2 class="fs-title">Incident information</h2>
                        <h3 class="fs-subtitle">Enter the details regarding the incident.</h3>
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                        <select id="type" name="type" required="">
                            <option disabled="" selected="selected" value="">Type</option>
                            <option value="internal">Internal</option>
                            <option value="ext" >External</option>
                        </select>
                        <input placeholder="Date and time of the incident" class="textbox-n" type="text" onfocus="(this.type='datetime-local')" name="date_incident" />
                        <input type="text" name="perspective" placeholder="Description" />
                        <input type="file"  multiple="true" class="o_website_form_input" name="incident_files" style="height:100px"></input>
                        <input type="button" name="next" class="next action-button" value="Next" />
                    </fieldset>
                    <fieldset>
                        <h2 class="fs-title">Additional information</h2>
                        <div class="form-inputs">
                            <div>
                                <h4>1. Identify the reason for the incident. You can select a maximum of 2 options.</h4>
                                <t t-foreach="reason_ids" t-as="adm">
                                    <label class="checkbox_container">
                                        <strong>
                                            <span t-esc="adm.name" />
                                            :
                                        </strong>
                                        <span t-esc="adm.description" />
                                        <input class="reason_checkbox" t-attf-name="reason_#{adm.id}" t-attf-id="reason_#{adm.id}" type="checkbox" t-att-value="adm.id" />
                                        <span class="checkmark"></span>
                                    </label>
                                </t>
                                <input type="text" name="reason_other" placeholder="Another reason" />
                            </div>
                            <div>
                            </div>
                        </div>
                        <input type="button" name="previous" class="previous action-button-previous" value="Previous" />
                        <input type="button" name="next" class="next action-button" value="Next" />
                    </fieldset>
                    <fieldset>
                        <h2 class="fs-title">Personal information</h2>
                        <h3 class="fs-subtitle">Enter your personal details</h3>
                        <input type="text" name="name" placeholder="Fist and last names" />
                        <input type="text" name="complainer_document_number" placeholder="Document number" />
                        <select id="complainer_delivery_type" name="complainer_delivery_type" >
                            <option selected="selected" value="">Select how you would like to receive the response to your incident.</option>
                            <option value="email">I want to receive it by email.</option>
                            <option value="phone">I want to receive it on my mobile phone.</option>
                        </select>
                        <input type="text" id="hidden_phone" style="display: none;" name="complainer_phone" placeholder="Phone" />
                        <input type="text" id="hidden_email" style="display: none;" name="complainer_email" placeholder="Email" />
                        <input type="button" name="previous" class="previous action-button-previous" value="Previous" />
                        <input type="submit" class="submit action-button o_website_form_send" value="REPORT AN INCIDENT" />
                    </fieldset>
                </form>
            </div>
        </t>


    </template>

    <template id="soy_cybersecurity_cybersecurity.incident_done" name="Incident completed">
        <t t-call="website.layout">
            <div class="thankyou-page" style="text-align: center; padding: 50px 0;">
                <div class="thankyou-content" style="max-width: 600px; margin: auto; padding: 30px; border-radius: 10px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); background: #f9f9f9;">
                    <!--<img src="/web/static/src/img/icons/thankyou_icon.png" alt="Thank You" style="width: 100px; height: auto; margin-bottom: 20px;"/>-->
                    <h1 style="color: #4CAF50; font-size: 36px; font-weight: bold; margin-bottom: 20px;">¡Gracias!</h1>
                    <p style="color: #666; font-size: 18px; line-height: 1.6; margin-bottom: 20px;">
                        El incidente ha sido enviado con éxito. Nos pondremos en contacto con usted lo antes posible.
                    </p>
                    <!--
                    <a href="/" style="display: inline-block; padding: 12px 30px; font-size: 18px; color: #fff; background: #4CAF50; border-radius: 5px; text-decoration: none; transition: background 0.3s;">
                        Volver a la página principal
                    </a>
                    -->
                </div>
            </div>
        </t>
        <!--
        <form>
            <div class="form-group form-field o_website_form_required_custom" align="center">
                <h1 style="align:center;padding-top:100px;text-weight:bold;">Gracias! Su incidente ha sido enviado</h1>
            </div>
        </form>
        -->
    </template>


</odoo>