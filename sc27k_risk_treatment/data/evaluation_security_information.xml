<!-- TODO: noupdate="1" was removed from this file so that -u updates the existing records to the
     English text. Add it back afterwards. -->
<odoo>

    <record id="evaluation_security_information" model="evaluation.evaluation">
        <field name="name">Information Security Risk Assessment</field>
        <field name="type">risk</field>
    </record>

    <!-- Impact = MAX(Confidentiality, Integrity, Availability, Traceability, Authenticity);
         Risk value = Probability x Impact. The criteria are identified by their
         sc27k_criterion_type (see models/evaluation_criterio.py), not by their name. -->
    <record id="criterio_security_probability" model="evaluation.criterio">
        <field name="name">Probability</field>
        <field name="description">Assesses the realistic possibility that the information security risk materializes, considering history, exposure, threats, existing vulnerabilities and currently implemented controls.</field>
        <field name="evaluation_id" ref="evaluation_security_information" />
        <field name="sc27k_criterion_type">probability</field>
    </record>
    <record id="criterio_security_confidentiality" model="evaluation.criterio">
        <field name="name">Confidentiality</field>
        <field name="description">Assesses the impact on the confidentiality of information if the risk materializes: unauthorized access, disclosure, copying or modification.</field>
        <field name="evaluation_id" ref="evaluation_security_information" />
        <field name="sc27k_criterion_type">confidentiality</field>
    </record>
    <record id="criterio_security_integrity" model="evaluation.criterio">
        <field name="name">Integrity</field>
        <field name="description">Assesses the impact on the integrity of information if the risk materializes: unauthorized modification, destruction or corruption.</field>
        <field name="evaluation_id" ref="evaluation_security_information" />
        <field name="sc27k_criterion_type">integrity</field>
    </record>
    <record id="criterio_security_availability" model="evaluation.criterio">
        <field name="name">Availability</field>
        <field name="description">Assesses the impact on the availability of information if the risk materializes: loss, damage or interruption of access.</field>
        <field name="evaluation_id" ref="evaluation_security_information" />
        <field name="sc27k_criterion_type">availability</field>
    </record>
    <record id="criterio_security_traceability" model="evaluation.criterio">
        <field name="name">Traceability</field>
        <field name="description">Assesses the impact on traceability if the risk materializes: loss of the ability to reconstruct who did what and when.</field>
        <field name="evaluation_id" ref="evaluation_security_information" />
        <field name="sc27k_criterion_type">traceability</field>
    </record>
    <record id="criterio_security_authenticity" model="evaluation.criterio">
        <field name="name">Authenticity</field>
        <field name="description">Assesses the impact on authenticity if the risk materializes: loss of the ability to verify the identity of users, systems or the origin of the information.</field>
        <field name="evaluation_id" ref="evaluation_security_information" />
        <field name="sc27k_criterion_type">authenticity</field>
    </record>

    <!-- Probability: 1-5 -->
    <record id="criterio_line_security_probability_1" model="evaluation.criterio.line">
        <field name="name">1 (Very Rare)</field>
        <field name="criterio_id" ref="criterio_security_probability" />
        <field name="value_less">1</field>
        <field name="value_high">1</field>
    </record>
    <record id="criterio_line_security_probability_2" model="evaluation.criterio.line">
